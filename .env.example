PORT=3000
DISABLE_HMR=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Enter this token in the AI tab. Never commit real keys or tokens.
AI_ACCESS_TOKEN=
# Explicit opt-in to unauthenticated AI (not recommended on public deployments).
ALLOW_PUBLIC_AI=false
AI_DAILY_LIMIT=100
# Optional exact browser origin when a trusted reverse proxy rewrites Host.
PUBLIC_ORIGIN=
