; ==============================================================================
; Inno Setup 6 Script for TreeForge Desktop Application
; سكربت Inno Setup لإنشاء مثبت ويندوز احترافي لتطبيق TreeForge
; ==============================================================================

#define MyAppName "TreeForge"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "TreeForge"
#define MyAppURL "https://github.com/kkh12u77409-dot/treefrog"
#define MyAppExeName "TreeForge.exe"

[Setup]
; Basic Application Identity & Output Configuration
AppId={{C6D2B1A8-7F4E-43B9-839A-D94A1D94301B}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

; Destination Directories
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
OutputDir=installer_output
OutputBaseFilename=TreeForge_Setup_v{#MyAppVersion}

; Compression & Optimization
Compression=lzma2/ultra64
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64compatible

; UI and Modern Styling
WizardStyle=modern
WizardResizable=no
DisableWelcomePage=no

; Icons and Visual Branding
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName}

; Privileges (Allows installing for single user or system-wide)
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog

[Languages]
Name: "arabic"; MessagesFile: "compiler:Languages\Arabic.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[CustomMessages]
arabic.LaunchProgramText=تشغيل تطبيق TreeForge الآن
arabic.CreateDesktopShortcut=إنشاء اختصار على سطح المكتب
english.LaunchProgramText=Launch TreeForge now
english.CreateDesktopShortcut=Create a desktop shortcut

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopShortcut}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
; Main Executable generated by build_exe.bat
Source: "dist\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion

; Embedded Application Assets and Icons (if available in build tree)
Source: "TreeForge\assets\*"; DestDir: "{app}\TreeForge\assets"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist
Source: "TreeForge\README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "TreeForge\CHANGELOG.md"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgramText}"; Flags: nowait postinstall skipifsilent
